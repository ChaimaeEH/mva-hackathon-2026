# Copy this file to config.env and replace every /path/to/... value.
# config.env is ignored by Git because it contains machine-specific paths.

INPUT_VCF="/path/to/WGS_EX2312012_HGWCNDSX7.vcf.gz"
REFERENCE_FASTA="/path/to/Homo_sapiens.GRCh38.dna.primary_assembly.fa"
EXOMISER_DIR="/path/to/exomiser-cli-14.1.0"
EXOMISER_JAR="${EXOMISER_DIR}/exomiser-cli-14.1.0.jar"
ANNOVAR_DIR="/path/to/annovar"
ANNOVAR_DB_DIR="${ANNOVAR_DIR}/humandb_hg38"
GNOMAD_CONSTRAINT_FILE="/path/to/gnomad.v4.1.1.constraint_metrics.tsv.bgz"

# Executables may be command names on PATH or absolute paths.
BCFTOOLS="bcftools"
JAVA="java"
PYTHON="python3"
PERL="perl"

VCF_SAMPLE_ID="WGS_EX2312012"
CHALLENGE_PROBAND_ID="PROBAND01"
OUTPUT_BASENAME="WGS_EX2312012_exomiser"
THREADS="4"
JAVA_MEMORY="24g"

# These names must match databases installed in ANNOVAR_DB_DIR.
GNOMAD_PROTOCOL="gnomad41_exome"
CLINVAR_PROTOCOL="clinvar_20250721"

